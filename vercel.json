{
  "installCommand": "git clone https://github.com/flutter/flutter.git --depth 1 -b stable $HOME/flutter",
  "buildCommand": "export PATH=\"$PATH:$HOME/flutter/bin\" && ls -la && cd mobile && flutter build web --release",
  "outputDirectory": "mobile/build/web",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ]
}